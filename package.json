{
  "name": "sentinelgraph",
  "version": "0.1.0",
  "description": "SentinelGraph — Graph-Augmented Retrieval for Cyber Threat Intelligence (BCSE302P)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "ensure-indexes": "node src/scripts/ensureIndexes.js",
    "ingest:attack": "node src/scripts/ingestAttack.js",
    "ingest:nvd": "node src/scripts/ingestNvd.js",
    "ingest:cisa": "node src/scripts/ingestCisaKev.js",
    "seed:software": "node src/scripts/seedSoftware.js",
    "seed:users": "node src/scripts/seedUsers.js",
    "seed:reports": "node src/scripts/seedReports.js",
    "demo": "node src/scripts/demoQueries.js"
  },
  "jest": {
    "setupFiles": ["<rootDir>/jest.setup.js"],
    "globalTeardown": "<rootDir>/jest.teardown.js",
    "testTimeout": 60000,
    "testPathIgnorePatterns": ["/node_modules/", "/data/", "/public/"],
    "modulePathIgnorePatterns": ["<rootDir>/data/"]
  },
  "keywords": [
    "neo4j",
    "mongodb",
    "cyber-threat-intelligence",
    "vector-search"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "neo4j-driver": "^5.24.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
