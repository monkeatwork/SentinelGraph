# Copy to .env and adjust. Never commit .env.
# --- Databases ---
MONGO_URI=mongodb://localhost:27017/sentinelgraph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentinelgraph

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Server ---
PORT=3000

# --- Embeddings ---
# transformers = @huggingface/transformers all-MiniLM-L6-v2 (384 dims, downloads model on first use)
# hash        = offline bag-of-words hashing (768 dims, zero downloads)
EMBEDDING_MODE=transformers
EMBEDDING_DIM=384

# --- MITRE STIX bundle cache (downloaded once, ~200 MB) ---
STIX_BUNDLE_PATH=./data/enterprise-attack.json